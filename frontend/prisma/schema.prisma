  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
  }

  model Modelo {
    id           String      @id @default(cuid())
    codigoReal   String      @unique  // RD-001 … RD-025
    nombre       String
    descripcion  String
    categoria    Categoria
    material     String      // PLA, TPU, PETG, PLA+
    costoBase    Int         // en COP
    archivoGlb   String      // ruta en /public/modelos/
    imagen       String      // ruta en /public/thumbnails/
    horasTotal   Float       // tiempo de producción total
    disponibles  Int         @default(0)
    solicitudes  Solicitud[]
  }

  model Solicitud {
    id            String   @id @default(cuid())
    codigoReal    String?  @unique  // SOL-001 … SOL-025 para datos semilla
    nombre        String
    cedula        String   @unique
    ciudad        String
    correo        String
    telefono      String
    institucion   String?
    tipoMaterial  Categoria
    modeloId      String
    cantidad      Int      @default(1)
    estado        Estado   @default(INTERESADO)
    prioridad     Prioridad @default(MEDIA)
    responsable   String?
    fechaRegistro DateTime @default(now())
    modelo        Modelo   @relation(fields: [modeloId], references: [id])
  }

  model ModeloGenerado {
    id            String          @id @default(cuid())
    taskId        String          @unique
    glbUrl        String          @default("")
    imagenUrl     String
    nombre        String?
    estado        EstadoGenerado  @default(PROCESANDO)
    creadoEn      DateTime        @default(now())
    actualizadoEn DateTime        @updatedAt
  }

  enum EstadoGenerado {
    PROCESANDO
    COMPLETADO
    FALLIDO
  }

  enum Categoria {
    ACCESIBILIDAD_VISUAL
    ACCESIBILIDAD_MOTRIZ
    MATERIAL_DIDACTICO
    COMUNICACION_AUMENTATIVA
    FIGURAS_DIDACTICAS
    ACCESORIOS_ACCESIBILIDAD
  }

  // Estados CRM (ficha técnica, obligatorios para evaluación)
  // + Estados de producción (Excel real de ANDES)
  enum Estado {
    // Fase CRM — seguimiento de contacto
    INTERESADO
    NO_INTERESADO
    CONFIRMO
    LLAMAR_DESPUES
    NO_RESPONDE
    NO_CONTESTO
    // Fase producción — flujo real de ANDES
    RECIBIDA
    EN_PRODUCCION
    REVISION_CALIDAD
    EMPAQUE_TRANSPORTE
    ENTREGADA
  }

  enum Prioridad {
    ALTA
    MEDIA
    BAJA
  }